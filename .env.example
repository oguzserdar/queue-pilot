# Postgres (Neon works). Better Auth, saved keys and the Buffer copy live here.
DATABASE_URL=
# Generate each one with the command beside it, then paste the result after the =.
# SESSION_SECRET: openssl rand -hex 32
SESSION_SECRET=
# SETTINGS_KEY (encrypts saved keys, 64 hex characters): openssl rand -hex 32
SETTINGS_KEY=
# ADMIN_SETUP_CODE: the code /admin asks for before the first person can claim this deployment, 24+ characters. Required in production: without it nobody can claim from the web (use pnpm admin:grant instead). openssl rand -hex 16
ADMIN_SETUP_CODE=
# Buffer: Settings → API in your Buffer account. The redirect URI must match exactly. It is this copy's own address
# followed by /api/auth/callback/buffer, and it also sets the address sign-in and the AI connector use. Docker and
# pnpm dev serve http://localhost:3000.
BUFFER_REDIRECT_URI=http://localhost:3000/api/auth/callback/buffer
# Needed for the first sign-in. A value saved later in /admin replaces these.
BUFFER_CLIENT_ID=
BUFFER_CLIENT_SECRET=
# Optional. Each of these can also be set in /admin instead; a value saved in /admin wins over the one here.
# Built-in AI, for people who have not connected their own AI: needs both a key and a budget.
# An Anthropic, OpenAI or OpenRouter key. Built-in AI stays off until a budget is set too.
FALLBACK_AI_KEY=
# Total to spend on built-in AI, all time. Each action's real cost is counted, and built-in AI stops when this is reached.
AI_BUDGET_USD=
# How many AI actions one person can run on your key each day.
# AI_CAP_PER_PERSON=10
# Optional ceiling on all built-in AI actions in one day, to spread the budget over time. Empty means no daily ceiling.
# AI_CAP_TOTAL=
# Optional. Adds YouTube transcripts to the material drafts are written from.
# SUPADATA_API_KEY=
# Optional. Lets the AI search the web for deeper context and save a page as material.
# EXA_API_KEY=
# Optional. Copies people's sent posts to their Telegram channel: the bot token from @BotFather and its username.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# Optional. Copies to Discord: the application ID, client secret and bot token from the Discord Developer Portal.
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_BOT_TOKEN=
# 32+ random characters. The daily job (/api/cron/echo) answers only with "Authorization: Bearer <CRON_SECRET>".
# Vercel Cron sends it for you. In Docker the cron service sends it.
CRON_SECRET=
# How many proxies in front of the app append to x-forwarded-for, 0 to 10. Unset: 1 on Vercel, 0 everywhere else
# (every visitor then shares one rate-limit bucket). Behind one reverse proxy, set 1. A number higher than the real
# chain lets visitors choose their own rate-limit bucket.
TRUSTED_PROXY_HOP_COUNT=
# Docker only, optional, instead of the hop count: the address(es) or ranges of your reverse proxy (Coolify, Traefik,
# nginx), comma separated, e.g. 10.0.0.0/8. When set it wins over TRUSTED_PROXY_HOP_COUNT; one invalid entry trusts nothing.
TRUSTED_PROXIES=
# Docker only: the database password docker-compose gives Postgres. openssl rand -hex 24
POSTGRES_PASSWORD=

# The homepage for signed-out visitors. Leave empty until it is launched: they see the example app instead.
LANDING_PAGE=
