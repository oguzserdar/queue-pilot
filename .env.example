# Postgres (Neon works). Better Auth, saved keys and the Buffer copy live here.
DATABASE_URL=
# Generate each one with the command beside it, then paste the result after the =.
# SESSION_SECRET: openssl rand -hex 32
SESSION_SECRET=
# SETTINGS_KEY (encrypts saved keys, 64 hex characters): openssl rand -hex 32
SETTINGS_KEY=
# ADMIN_SETUP_CODE: the code /admin asks for before the first person can claim this deployment, 24+ characters. openssl rand -hex 16
ADMIN_SETUP_CODE=
# Buffer: Settings → API in your Buffer account. The redirect URI must match exactly.
BUFFER_REDIRECT_URI=https://localhost:4417/api/auth/callback/buffer
# Needed for the first sign-in. While set here, /admin shows them read-only.
BUFFER_CLIENT_ID=
BUFFER_CLIENT_SECRET=
# Optional. Each of these can also be set in /admin instead; a value here wins and /admin shows it read-only.
# Built-in AI, for people who have not connected their own AI: needs both a key and a budget.
# An Anthropic, OpenAI or OpenRouter key. Built-in AI stays off until a budget is set too.
FALLBACK_AI_KEY=
# Total to spend on built-in AI, all time. Each action's real cost is counted, and built-in AI stops when this is reached.
AI_BUDGET_USD=
# How many AI actions one person can run on your key each day.
# AI_CAP_PER_PERSON=10
# Optional ceiling on all built-in AI actions in one day, to spread the budget over time. Empty means no daily ceiling.
# AI_CAP_TOTAL=
# Optional. Adds YouTube transcripts to the material drafts are written from.
# SUPADATA_API_KEY=
# 32+ random characters. The daily job (/api/cron/echo) answers only with "Authorization: Bearer <CRON_SECRET>".
# Vercel Cron sends it for you. In Docker the cron service sends it.
CRON_SECRET=
# Docker only, optional: the address(es) of your reverse proxy (Coolify, Traefik, nginx), comma separated, so each
# visitor gets their own rate-limit bucket. Vercel needs nothing here.
TRUSTED_PROXIES=
# Docker only: the database password docker-compose gives Postgres. openssl rand -hex 24
POSTGRES_PASSWORD=
