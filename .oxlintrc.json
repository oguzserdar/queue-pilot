{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // Code-quality gate. Every rule is an error. Code that already breaks a rule is counted in
  // scripts/lint-baseline.json, and that count may only go down (scripts/check-lint.mjs): new code must pass.
  //
  // Numbers: files 350 code lines (.ts) and 450 (.tsx), blank and comment lines not counted; functions 100 lines;
  // complexity 20 decision points. Depth 4 and nested callbacks 4 follow ESLint's defaults until the owner sets ours.
  //
  // When a rule fires: fix the code. Do not raise a number, add a disable comment, or cast to get past it.
  "plugins": ["typescript", "react", "vitest", "import", "unicorn", "oxc"],
  "categories": { "correctness": "error" },
  "rules": {
    "typescript/consistent-type-assertions": ["error", { "assertionStyle": "never" }],
    "typescript/no-non-null-assertion": "error",
    "typescript/no-explicit-any": "error",
    "typescript/ban-ts-comment": "error",
    "typescript/no-unsafe-type-assertion": "error",
    "typescript/no-floating-promises": "error",
    "eslint/no-warning-comments": "off",
    "max-lines": ["error", { "max": 350, "skipBlankLines": true, "skipComments": true }],
    "max-lines-per-function": ["error", { "max": 100, "skipBlankLines": true, "skipComments": true }],
    "complexity": ["error", { "max": 20 }],
    "max-depth": ["error", { "max": 4 }],
    "max-nested-callbacks": ["error", { "max": 4 }],
    "no-nested-ternary": "error",
    "vitest/no-focused-tests": "error",
    "jest/no-identical-title": "error"
  },
  "overrides": [
    {
      "files": ["**/*.tsx"],
      "rules": { "max-lines": ["error", { "max": 450, "skipBlankLines": true, "skipComments": true }] }
    },
    {
      // Tests build fakes and fixtures; casts there are allowed, everything else holds.
      "files": ["**/*.test.ts", "**/*.test.tsx", "src/test/**"],
      "rules": {
        "typescript/consistent-type-assertions": "off",
        "typescript/no-unsafe-type-assertion": "off",
        "typescript/no-non-null-assertion": "off",
        "max-lines-per-function": "off",
        "max-nested-callbacks": "off"
      }
    }
  ],
  // src/registry is the Arc library copied as is (THIRD_PARTY_NOTICES.md); copied code is kept identical to its source
  // and left out of our lint, as projects that copy UI code commonly do (the owner chose this). Our own code never goes
  // there: scripts/check-registry.mjs fails on any file that is not from Arc.
  "ignorePatterns": [".next/**", "node_modules/**", "drizzle/**", "public/**", "third-party/**", "src/db/auth-schema.ts", "src/registry/**", "src/lib/arc-provider.tsx", "src/lib/media.ts", "src/lib/motion-tokens.ts", "src/lib/use-copy-feedback.ts", "src/lib/use-today.ts"]
}
