{
  "name": "app",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run --maxWorkers=2",
    "eval": "vitest run -c vitest.evals.config.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "auth:schema": "DATABASE_URL=postgres://schema:only@localhost:5432/none auth generate --config src/db/auth-cli-config.ts --adapter drizzle --dialect pg --output src/db/auth-schema.ts -y",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config=drizzle.config.ts",
    "vercel-build": "node scripts/migrate-on-deploy.mjs && next build",
    "release": "node scripts/release.mjs",
    "check:copy": "python3 scripts/copy-gate.py README.md CHANGELOG.md ROADMAP.md CONTRIBUTING.md",
    "admin:grant": "node scripts/grant-admin.mjs",
    "prepare": "husky",
    "check:gates": "vitest run --maxWorkers=2 src/lib/no-product-names.test.ts src/lib/copy-rules.test.ts src/lib/css-modules.test.ts src/lib/settings-parity.test.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.99",
    "@ai-sdk/openai": "4.0.111",
    "@better-auth/cimd": "1.7.18",
    "@better-auth/mcp": "1.7.18",
    "@better-auth/oauth-provider": "1.7.18",
    "@lobehub/fluent-emoji": "5.0.1",
    "@lobehub/icons": "6.15.0",
    "@lobehub/ui": "6.15.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@rowanmanning/feed-parser": "2.1.5",
    "@tabler/icons-react": "3.51.0",
    "@vercel/analytics": "2.0.1",
    "@vercel/functions": "3.11.0",
    "ai": "7.0.166",
    "better-auth": "1.7.18",
    "drizzle-orm": "0.45.4",
    "fflate": "0.8.3",
    "ipaddr.js": "2.5.0",
    "lucide-react": "1.70.0",
    "motion": "14.10.1",
    "next": "16.4.5",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "undici": "8.12.4",
    "workflow": "5.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@ai-sdk/provider": "4.0.37",
    "@electric-sql/pglite": "0.5.15",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.11",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@10.2.1",
  "pnpm": {
    "overrides": {
      "body-parser@<2.4.0": ">=2.4.0 <3",
      "zod@>=4 <4.6.6": ">=4.6.6 <5"
    }
  }
}
